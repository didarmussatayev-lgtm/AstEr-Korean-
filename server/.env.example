# Postgres connection string
DATABASE_URL=postgres://aster:aster@localhost:5432/aster
# Long random string, REQUIRED in production (openssl rand -hex 32)
JWT_SECRET=change-me
PORT=3000
# Allowed browser origins for the API, comma separated. Not needed when the site is served by this server.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Can students sign up themselves? (true/false)
ALLOW_REGISTRATION=true
# First administrator, created on start if the e-mail does not exist yet
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
