{
  "name": "aster-korean-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p .",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p . --noEmit",
    "test": "tsx --env-file-if-exists=.env test/e2e.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^10.1.7",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.8",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
